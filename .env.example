DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facultysol?schema=public"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Document AI uses Application Default Credentials, not GEMINI_API_KEY.
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Optional local setup: GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
MAX_UPLOAD_SIZE=10485760
MAX_DOCUMENT_PAGES=80
MAX_IMAGE_PIXELS=40000000
OCR_TIMEOUT_MS=60000
DEV_DATA_FILE=./data/reviews.json
MAX_ANALYSIS_CHARS=120000
AI_TIMEOUT_MS=45000
PORT=4000
WEB_ORIGIN=http://localhost:5173
